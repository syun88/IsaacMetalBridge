# Copy to .env after loading the real image outside Git.
# Do not store registry credentials or license-acceptance values here.
IMB_ISAAC_IMAGE=nvcr.io/nvidia/isaac-sim:6.0.1
IMB_ISAAC_PLATFORM=linux/arm64
# Optional: the launcher otherwise assigns 75% of physical memory (24g on a 32 GiB Mac).
# IMB_ISAAC_MEMORY=24g
