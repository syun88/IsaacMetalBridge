#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Perspective = {
                double3 position = (4.5, 4.5, 3.5)
                double3 target = (0, 0, 0.5)
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
    }
)

def Xform "World"
{
    def Mesh "Cube"
    {
        uniform token subdivisionScheme = "none"
        point3f[] points = [
            (-0.75, -0.75, 0.0),
            ( 0.75, -0.75, 0.0),
            ( 0.75,  0.75, 0.0),
            (-0.75,  0.75, 0.0),
            (-0.75, -0.75, 1.5),
            ( 0.75, -0.75, 1.5),
            ( 0.75,  0.75, 1.5),
            (-0.75,  0.75, 1.5)
        ]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [
            0, 3, 2, 1,
            4, 5, 6, 7,
            0, 1, 5, 4,
            1, 2, 6, 5,
            2, 3, 7, 6,
            3, 0, 4, 7
        ]
        color3f[] primvars:displayColor = [(0.12, 0.48, 0.95)]
        uniform token primvars:displayColor:interpolation = "constant"
        float3[] extent = [(-0.75, -0.75, 0.0), (0.75, 0.75, 1.5)]
    }

    def Mesh "Ground"
    {
        uniform token subdivisionScheme = "none"
        point3f[] points = [
            (-5, -5, -0.02),
            ( 5, -5, -0.02),
            ( 5,  5, -0.02),
            (-5,  5, -0.02)
        ]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        color3f[] primvars:displayColor = [(0.3, 0.32, 0.35)]
        uniform token primvars:displayColor:interpolation = "constant"
        float3[] extent = [(-5, -5, -0.02), (5, 5, -0.02)]
    }

    def DistantLight "KeyLight"
    {
        float intensity = 2500
        float angle = 1
        color3f color = (1.0, 0.93, 0.82)
        double3 xformOp:rotateXYZ = (-40, 25, 25)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def DomeLight "FillLight"
    {
        float intensity = 400
        color3f color = (0.28, 0.36, 0.5)
    }
}
