#version 450

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Values {
    uint values[];
};

layout(push_constant) uniform Constants {
    uint addend;
} constants;

void main() {
    values[gl_GlobalInvocationID.x] += constants.addend;
}
