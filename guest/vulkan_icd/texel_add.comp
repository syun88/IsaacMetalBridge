#version 450

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, r32ui) uniform uimageBuffer values;

layout(push_constant) uniform Parameters {
    uint addend;
} parameters;

void main() {
    int index = int(gl_GlobalInvocationID.x);
    uint value = imageLoad(values, index).x;
    imageStore(values, index, uvec4(value + parameters.addend));
}
